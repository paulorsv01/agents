{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.025,
  "env": {
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.dev)",
      "Read(**/.env.prod)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(**/*secrets*)",
      "Read(**/secret.*)",
      "Read(**/*.secret)",
      "Read(**/*-secret*)",
      "Read(**/*_secret*)",
      "Read(~/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.agents/claude/statusline-command.py"
  },
  "enabledPlugins": {},
